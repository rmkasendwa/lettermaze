{
  "name": "lettermaze",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "docker compose up -d postgres && pnpm db:deploy && pnpm build:contracts && concurrently --kill-others --names web,api \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "pnpm --filter @lettermaze/web dev",
    "dev:api": "pnpm --filter @lettermaze/api dev",
    "build": "pnpm build:contracts && pnpm build:game && pnpm build:api && pnpm build:web",
    "build:contracts": "pnpm --filter @lettermaze/contracts build",
    "build:game": "pnpm --filter @lettermaze/game build",
    "build:web": "pnpm --filter @lettermaze/web build",
    "build:api": "pnpm --filter @lettermaze/api build",
    "start": "node scripts/start-production.mjs",
    "start:web": "pnpm --filter @lettermaze/web start",
    "start:api": "pnpm --filter @lettermaze/api start",
    "typecheck": "pnpm build:contracts && pnpm --recursive --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --recursive --if-present test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "container:db:deploy": "node scripts/deploy-migrations.mjs",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.2",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prisma": "^6.19.2",
    "typescript-eslint": "^8.46.2",
    "typescript": "^5.9.3"
  }
}
