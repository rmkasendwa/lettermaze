generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String?           @unique
  name             String?
  passwordHash     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  statistics       PlayerStatistics?
  statisticImports StatisticImport[]
  completedGames   CompletedGame[]
  dailyCompletions DailyCompletion[]
  achievements     UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
}

model DailyCompletion {
  id        String   @id @default(cuid())
  userId    String
  localDate String
  puzzleId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate])
  @@index([userId, localDate])
}

model CompletedGame {
  id              String   @id @default(cuid())
  userId          String
  score           Int
  wordsFound      Int
  words           String[]
  boardSize       Int
  durationSeconds Int
  longestWord     String   @default("")
  isDaily         Boolean  @default(false)
  puzzleId        String?
  completedAt     DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt, id])
  @@index([userId, isDaily])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PlayerStatistics {
  userId          String @id
  gamesPlayed     Int    @default(0)
  totalWordsFound Int    @default(0)
  highestScore    Int    @default(0)
  mostWordsFound  Int    @default(0)
  longestWord     String @default("")
  bestDailyScore  Int    @default(0)
  totalScore      Int    @default(0)
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StatisticImport {
  id        String   @id
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DailyScore {
  id          String   @id @default(cuid())
  puzzleId    String
  playerId    String
  score       Int
  wordsFound  Int
  submittedAt DateTime @default(now())

  @@unique([puzzleId, playerId])
  @@index([puzzleId, score])
}
