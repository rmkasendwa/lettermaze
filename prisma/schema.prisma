generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyScore {
  id          String   @id @default(cuid())
  puzzleId    String
  playerId    String
  score       Int
  wordsFound  Int
  submittedAt DateTime @default(now())

  @@unique([puzzleId, playerId])
  @@index([puzzleId, score])
}
